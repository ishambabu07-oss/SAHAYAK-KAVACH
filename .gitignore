# =========================
# SAHAYAK-KAVACH .gitignore
# =========================

# ---------- OS ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# -------- IDEs ----------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ----- Environment ------
.env
.env.*
!.env.example

# -------- Python --------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/

# ------- Node.js --------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------- Frontend -------
frontend/node_modules/
frontend/dist/
frontend/.cache/

# ------- Backend --------
backend/__pycache__/
backend/.venv/

# ------ AI Engine -------
ai_engine/__pycache__/
ai_engine/.venv/
*.pt
*.onnx
*.bin
*.h5

# ------- Database -------
*.db
*.sqlite3

# --------- Logs ---------
logs/
*.log

